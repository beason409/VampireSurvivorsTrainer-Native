<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VampireSurvivorsTrainer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <Version>1.0.1-preview.2</Version>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Authors>Beason9527</Authors>
    <Company>Beason9527</Company>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\App.ico" LogicalName="Trainer.Desktop.Assets.App.ico" />
    <EmbeddedResource Include="Localization\*.en.json" WithCulture="false" />
    <ProjectReference Include="..\Trainer.Shared\Trainer.Shared.csproj" />
    <ProjectReference Include="..\Trainer.Core\Trainer.Core.csproj" />
  </ItemGroup>
</Project>
