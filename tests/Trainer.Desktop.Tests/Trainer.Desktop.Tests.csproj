<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Baseline Condition="'$(Baseline)' == ''">false</Baseline>
    <DefineConstants Condition="'$(Baseline)' == 'true'">$(DefineConstants);BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Trainer.Shared/Protocol.cs" Link="ActualSource/Protocol.cs" />
    <Compile Include="../../src/Trainer.Shared/StatCatalog.cs" Link="ActualSource/StatCatalog.cs" />
    <Compile Include="../../src/Trainer.Desktop/DarkButton.cs" Link="ActualSource/DarkButton.cs" />
    <Compile Include="../../src/Trainer.Desktop/ChestRewardPanel.cs" Link="ActualSource/ChestRewardPanel.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="../../src/Trainer.Desktop/ChestRewardPanel.Icons.cs" Link="ActualSource/ChestRewardPanel.Icons.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="../../src/Trainer.Desktop/DesktopSettings.cs" Link="ActualSource/DesktopSettings.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="../../src/Trainer.Desktop/HotkeyService.cs" Link="ActualSource/HotkeyService.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="../../src/Trainer.Desktop/UiLocalization.cs" Link="ActualSource/UiLocalization.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="../../src/Trainer.Desktop/LocalizedToolTip.cs" Link="ActualSource/LocalizedToolTip.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="../../src/Trainer.Desktop/Dialogs.cs" Link="ActualSource/Dialogs.cs" Condition="'$(Baseline)' != 'true'" />
    <Compile Include="../../artifacts/search-performance/baseline/ChestRewardPanel.cs" Link="BaselineSource/ChestRewardPanel.cs" Condition="'$(Baseline)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(Baseline)' != 'true'">
    <EmbeddedResource Include="../../src/Trainer.Desktop/Localization/*.en.json" Link="Localization/%(Filename)%(Extension)" LogicalName="Trainer.Desktop.Localization.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
