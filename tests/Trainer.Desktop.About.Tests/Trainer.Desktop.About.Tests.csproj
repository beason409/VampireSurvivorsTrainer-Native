<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Trainer.Shared/Protocol.cs" Link="ActualSource/Protocol.cs" />
    <Compile Include="../../src/Trainer.Core/Models.cs" Link="ActualSource/Models.cs" />
    <Compile Include="../../src/Trainer.Core/TrustedPayloadCatalog.cs" Link="ActualSource/TrustedPayloadCatalog.cs" />
    <Compile Include="../../src/Trainer.Desktop/ReleaseInfoDialog.cs" Link="ActualSource/ReleaseInfoDialog.cs" />
    <Compile Include="../../src/Trainer.Desktop/ReleaseInfo.cs" Link="ActualSource/ReleaseInfo.cs" />
    <Compile Include="../../src/Trainer.Desktop/AppBranding.cs" Link="ActualSource/AppBranding.cs" />
    <Compile Include="../../src/Trainer.Desktop/DarkButton.cs" Link="ActualSource/DarkButton.cs" />
    <Compile Include="../../src/Trainer.Desktop/UiLocalization.cs" Link="ActualSource/UiLocalization.cs" />
    <EmbeddedResource Include="../../src/Trainer.Desktop/Assets/App.ico" LogicalName="Trainer.Desktop.Assets.App.ico" />
    <EmbeddedResource Include="../../src/Trainer.Desktop/Localization/*.en.json" Link="Localization/%(Filename)%(Extension)" LogicalName="Trainer.Desktop.Localization.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Fixtures/empty-payload-catalog.json" LogicalName="Trainer.Core.TrustedPayloadCatalog.json" WithCulture="false" />
  </ItemGroup>
</Project>
